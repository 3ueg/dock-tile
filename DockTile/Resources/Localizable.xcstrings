    "alert.missingAppsScan.noneTitle": {
      "comment": "Title of the manual scan dialog when every tile app is installed",
      "extractionState": "manual",
      "localizations": {
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "No Missing Apps"
          }
        },
