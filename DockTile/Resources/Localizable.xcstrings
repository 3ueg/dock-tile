          }
        }
      }
    },
    "alert.missingAppsScan.noneMessage": {
      "comment": "Message of the manual scan dialog when nothing is missing",
      "extractionState": "manual",
      "localizations": {
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Every app in your tiles is currently installed."
          }
