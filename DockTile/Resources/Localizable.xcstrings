          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Some apps are no longer installed"
          }
        }
      }
    },
    "alert.missingAppsScan.foundMessage": {
      "comment": "Intro line of the manual scan results dialog; a list of tiles/apps follows",
      "extractionState": "manual",
      "localizations": {
        "en-AU": {
